<div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-6 z-50 mx-auto w-fit translate-y-4 rounded-lg bg-emerald px-4 py-2 text-sm font-semibold text-ink opacity-0 shadow-lg transition duration-300"></div>

<script>
/* =====================================================
   CONFIGURATION – tout ce qui se modifie est ici
   ===================================================== */
const CONFIG = {
  // ⚠ Remplacez ces chiffres par vos résultats réellement mesurés avant mise en ligne.
  stats: [
    { label: "Précision du modèle", value: "88.4%" },
    { label: "Matchs analysés", value: "1,420+" },
    { label: "ROI moyen", value: "+14.2%" },
    { label: "Statut serveur", value: "Online", live: true }
  ],
  vip: {
    phoneDisplay: "+226 74 82 33 24",
    phoneCopy: "+22674823324",
    whatsapp: "22674823324",
    price: "20 000 FCFA" // montant de l’abonnement, repris partout sur la page
  },
  valueThreshold: 0.05 // avantage minimal pour signaler un value bet (5 %)
};

/* Matchs de démonstration : utilisés uniquement si /api/matches est indisponible. */
const DEMO_MATCHES = [
  { league: "Premier League", time: "Aujourd’hui · 17:30", home: "Liverpool", away: "Brighton", xgH: 1.95, xgA: 1.25,
    odds: { h: 1.62, d: 4.30, a: 5.40 }, over25: 1.68, corners: { line: 9.5, mean: 10.9, odd: 1.85 } },
  { league: "Premier League", time: "Aujourd’hui · 20:00", home: "Arsenal", away: "Newcastle", xgH: 1.80, xgA: 1.05,
    odds: { h: 1.85, d: 3.80, a: 4.50 }, over25: 1.95, corners: { line: 9.5, mean: 10.2, odd: 1.95 } },
  { league: "La Liga", time: "Aujourd’hui · 19:00", home: "Barcelone", away: "Séville", xgH: 2.15, xgA: 0.85,
    odds: { h: 1.45, d: 4.80, a: 7.00 }, over25: 1.80, corners: { line: 10.5, mean: 11.4, odd: 1.90 } },
  { league: "La Liga", time: "Aujourd’hui · 21:00", home: "Atlético", away: "Valence", xgH: 1.55, xgA: 0.80,
    odds: { h: 1.70, d: 3.70, a: 5.20 }, over25: 2.20, corners: { line: 9.5, mean: 9.9, odd: 1.80 } }
];
let MATCHES = DEMO_MATCHES;

/* =====================================================
   MODÈLE : Poisson + xG
   ===================================================== */
const MAXG = 10;
function pmf(lambda, n) {
  const p = [Math.exp(-lambda)];
  for (let k = 1; k <= n; k++) p.push(p[k - 1] * lambda / k);
  return p;
}
function analyse(m) {
  const ph = pmf(m.xgH, MAXG), pa = pmf(m.xgA, MAXG);
  let h = 0, d = 0, a = 0, o25 = 0;
  for (let i = 0; i <= MAXG; i++) for (let j = 0; j <= MAXG; j++) {
    const p = ph[i] * pa[j];
    if (i > j) h += p; else if (i === j) d += p; else a += p;
    if (i + j >= 3) o25 += p;
  }
  const t = h + d + a;
  h /= t; d /= t; a /= t; o25 /= t;
  const picks = [
    { name: "Victoire " + m.home, p: h, odd: m.odds.h },
    { name: "Match nul", p: d, odd: m.odds.d },
    { name: "Victoire " + m.away, p: a, odd: m.odds.a },
    { name: "Plus de 2,5 buts", p: o25, odd: m.over25 }
  ];
  if (m.corners) { // Corners : P(total > ligne), total ~ Poisson(moyenne)
    const pc = pmf(m.corners.mean, 40), k = Math.floor(m.corners.line);
    picks.push({ name: "Plus de " + String(m.corners.line).replace(".", ",") + " corners",
      p: 1 - pc.slice(0, k + 1).reduce((s, x) => s + x, 0), odd: m.corners.odd });
  }
  picks.forEach(x => (x.value = x.odd ? x.p * x.odd - 1 : -1));
  const priced = picks.filter(x => x.odd);
  const best = priced.length ? priced.reduce((b, x) => (x.value > b.value ? x : b)) : null;
  return { h, d, a, picks, best };
}

/* =====================================================
   AFFICHAGE
   ===================================================== */
const $ = s => document.querySelector(s);
const pct = x => (x * 100).toFixed(0) + "%";
const fmt = x => (x == null ? "–" : x.toFixed(2).replace(".", ","));

function renderStats() {
  $("#stats").innerHTML = CONFIG.stats.map(s => `
    <div class="card rounded-xl border border-gray-800 p-4 text-center sm:p-5">
      <div class="flex items-center justify-center gap-2 font-display text-2xl font-bold sm:text-3xl ${s.live ? "text-emerald" : "text-white"}">
        ${s.live ? '<span class="relative flex h-2.5 w-2.5"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald opacity-75"></span><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald"></span></span>' : ""}
        ${s.value}
      </div>
      <div class="mt-1 text-xs text-gray-400 sm:text-sm">${s.label}</div>
    </div>`).join("");
}

function oddBox(label, p) {
  const isValue = p.value >= CONFIG.valueThreshold;
  return `<div class="rounded-lg border ${isValue ? "border-gold/60 bg-gold/10" : "border-gray-800 bg-ink/50"} px-2 py-2 text-center">
    <div class="truncate text-[11px] text-gray-400">${label}</div>
    <div class="font-display text-lg font-bold ${isValue ? "text-gold" : "text-white"}">${fmt(p.odd)}</div>
    <div class="text-[11px] text-gray-500">équitable ${fmt(1 / p.p)}</div>
  </div>`;
}

function marketRow(p) {
  const isValue = p.value >= CONFIG.valueThreshold;
  return `<div class="flex items-center justify-between gap-2 border-t border-gray-800 py-2 text-sm">
    <span class="text-gray-300">${p.name}</span>
    <span class="flex items-center gap-3">
      <span class="text-gray-400">${pct(p.p)}</span>
      <span class="w-12 text-right font-semibold ${isValue ? "text-gold" : "text-white"}">${fmt(p.odd)}</span>
    </span>
  </div>`;
}

function matchCard(m) {
  const r = analyse(m), [ph, pd, pa, po, pc] = r.picks;
  const hasValue = r.best && r.best.value >= CONFIG.valueThreshold;
  return `<article class="card rounded-2xl border border-gray-800 p-5">
    <div class="flex items-center justify-between text-xs text-gray-400">
      <span>${m.league}</span><span>${when(m)}</span>
    </div>
    <div class="mt-3 flex items-center justify-between gap-3 font-display text-lg font-bold text-white sm:text-xl">
      <span>${m.home}</span><span class="text-xs font-medium text-gray-500">xG ${fmt(m.xgH)} – ${fmt(m.xgA)}</span><span class="text-right">${m.away}</span>
    </div>
    <div class="mt-3 flex h-8 overflow-hidden rounded-md text-xs font-semibold text-ink" role="img"
         aria-label="${m.home} ${pct(r.h)}, nul ${pct(r.d)}, ${m.away} ${pct(r.a)}">
      <div class="grid min-w-[2.5rem] place-items-center bg-emerald" style="flex:${r.h}">${pct(r.h)}</div>
      <div class="grid min-w-[2.5rem] place-items-center bg-gray-500" style="flex:${r.d}">${pct(r.d)}</div>
      <div class="grid min-w-[2.5rem] place-items-center bg-gold" style="flex:${r.a}">${pct(r.a)}</div>
    </div>
    <div class="mt-3 grid grid-cols-3 gap-2">
      ${oddBox("1", ph)}${oddBox("N", pd)}${oddBox("2", pa)}
    </div>
    <div class="mt-3">${marketRow(po)}${pc ? marketRow(pc) : ""}</div>
    <div class="mt-3 rounded-lg px-3 py-2 text-sm ${hasValue ? "bg-gold/10 text-gold ring-1 ring-gold/40" : "bg-ink/50 text-gray-400"}">
      ${hasValue
        ? `<strong>Value bet :</strong> ${r.best.name} à ${fmt(r.best.odd)} <span class="opacity-80">(avantage estimé +${(r.best.value * 100).toFixed(1).replace(".", ",")}%)</span>`
        : r.best ? "Aucun value bet détecté sur ce match : mieux vaut passer." : "Cotes indisponibles pour ce match."}
    </div>
  </article>`;
}

let currentLeague = "Tous";
function renderMatches() {
  const list = currentLeague === "Tous" ? MATCHES : MATCHES.filter(m => m.league === currentLeague);
  $("#matches").innerHTML = list.map(matchCard).join("") || '<p class="col-span-full text-gray-400">Aucun match à afficher.</p>';
  document.querySelectorAll("#tabs button").forEach(b => {
    const on = b.dataset.l === currentLeague;
    b.setAttribute("aria-selected", on);
    b.className = "rounded-full border px-4 py-1.5 text-sm font-medium transition " +
      (on ? "border-emerald bg-emerald/15 text-emerald" : "border-gray-800 text-gray-400 hover:text-white");
  });
}
function renderTabs() {
  const leagues = ["Tous", ...new Set(MATCHES.map(m => m.league))];
  $("#tabs").innerHTML = leagues.map(l => `<button type="button" role="tab" data-l="${l}">${l}</button>`).join("");
}

/* ---------- VIP : copie du numéro + WhatsApp ---------- */
let toastTimer;
function toast(msg) {
  const t = $("#toast");
  t.textContent = msg;
  t.classList.remove("opacity-0", "translate-y-4");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.add("opacity-0", "translate-y-4"), 2200);
}
async function copyNumber() {
  const num = CONFIG.vip.phoneCopy;
  try {
    await navigator.clipboard.writeText(num);
  } catch (e) {
    const ta = document.createElement("textarea");
    ta.value = num; ta.style.position = "fixed"; ta.style.opacity = "0";
    document.body.appendChild(ta); ta.select();
    try { document.execCommand("copy"); } catch (_) {}
    ta.remove();
  }
  toast("Numéro copié : " + CONFIG.vip.phoneDisplay);
  const b = $("#copy-btn");
  b.textContent = "Numéro copié ✔";
  setTimeout(() => (b.textContent = "Copier le numéro"), 2200);
}
function renderVip() {
  $("#vip-phone").textContent = CONFIG.vip.phoneDisplay;
  const price = CONFIG.vip.price;
  $("#vip-price").textContent = price;
  $("#vip-step1").textContent = "1. Envoyez " + price + " au numéro ci-dessous.";
  const msg = "Bonjour, je souhaite activer l’abonnement VIP Omni-Matrix de STX ScoreMaster (" + price + "). Voici la capture de mon paiement Orange Money.";
  $("#wa-btn").href = "https://wa.me/" + CONFIG.vip.whatsapp + "?text=" + encodeURIComponent(msg);
  $("#copy-btn").addEventListener("click", copyNumber);
}

const when = m => m.time || new Date(m.kickoff).toLocaleString("fr-FR", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });

/* ---------- Données réelles via la fonction serveur /api/matches ---------- */
async function loadLive() {
  try {
    const r = await fetch("/api/matches");
    const j = await r.json();
    if (!r.ok) throw new Error(j.error || "HTTP " + r.status);
    MATCHES = j.matches;
    $("#source").textContent = j.matches.length
      ? "Matchs réels · source API-Football · actualisé toutes les 4 h"
      : "Aucun match des 5 grands championnats dans les 3 prochains jours.";
  } catch (e) {
    console.warn("API indisponible :", e.message);
    $("#source").textContent = "Mode démonstration : données d’exemple, pas de vrais matchs (API indisponible).";
  }
}

$("#tabs").addEventListener("click", e => {
  const b = e.target.closest("button");
  if (b) { currentLeague = b.dataset.l; renderMatches(); }
});
renderStats(); renderVip();
$("#matches").innerHTML = '<p class="col-span-full text-gray-400">Chargement des matchs…</p>';
loadLive().finally(() => { renderTabs(); renderMatches(); });
</script>
