<script>
const $ = s => document.querySelector(s);
const $$ = s => document.querySelectorAll(s);

let MATCHES = [];
let currentLeague = "Tous";

const LEAGUES = [
  { name: "Tous", code: "ALL" },
  { name: "Premier League", code: "Premier League" },
  { name: "La Liga", code: "La Liga" },
  { name: "Serie A", code: "Serie A" },
  { name: "Bundesliga", code: "Bundesliga" },
  { name: "Ligue 1", code: "Ligue 1" },
  { name: "Champions League", code: "UEFA Champions League" }
];

function poisson(lambda, k) {
  return (Math.pow(lambda, k) * Math.exp(-lambda)) / factorial(k);
}
function factorial(n) {
  return n <= 1 ? 1 : n * factorial(n - 1);
}

function calculatePoissonMatrix(xgH, xgA) {
  let homeWin = 0, draw = 0, awayWin = 0;
  for (let h = 0; h < 7; h++) {
    for (let a = 0; a < 7; a++) {
      let p = poisson(xgH, h) * poisson(xgA, a);
      if (h > a) homeWin += p;
      else if (h === a) draw += p;
      else awayWin += p;
    }
  }
  const total = homeWin + draw + awayWin;
  return {
    home: homeWin / total,
    draw: draw / total,
    away: awayWin / total
  };
}

function renderTabs() {
  const container = $("#tabs");
  container.innerHTML = LEAGUES.map(l => `
    <button data-l="${l.name}" class="px-4 py-2 rounded-xl text-xs font-semibold transition ${currentLeague === l.name ? 'bg-emerald-500 text-ink font-bold shadow-md shadow-emerald-500/20' : 'bg-gray-800/60 text-gray-400 hover:text-white'}">
      ${l.name}
    </button>
  `).join('');
}

function renderMatches() {
  const container = $("#matches");
  const filtered = currentLeague === "Tous" ? MATCHES : MATCHES.filter(m => m.league === currentLeague);
  
  if (filtered.length === 0) {
    container.innerHTML = `<p class="col-span-full text-center py-12 text-gray-400">Aucun match disponible pour cette sélection.</p>`;
    return;
  }

  container.innerHTML = filtered.map(m => {
    const probs = calculatePoissonMatrix(m.xgHome, m.xgAway);
    const oddH = 1 / probs.home;
    const oddD = 1 / probs.draw;
    const oddA = 1 / probs.away;
    const bestValue = Math.max(probs.home * oddH, probs.draw * oddD, probs.away * oddA);
    const isValue = bestValue > 1.05;

    return `
      <div class="card p-5 rounded-2xl border border-gray-800 relative overflow-hidden flex flex-col justify-between space-y-4">
        ${isValue ? '<div class="absolute top-0 right-0 bg-amber-500 text-ink text-[10px] font-bold px-3 py-1 rounded-bl-xl shadow">VALUE BET</div>' : ''}
        <div>
          <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
            <span class="font-semibold text-emerald-400">${m.league}</span>
            <span class="bg-gray-800 px-2 py-0.5 rounded">${m.time}</span>
          </div>
          <div class="flex items-center justify-between font-display font-bold text-lg my-3">
            <span>${m.home}</span>
            <span class="text-xs text-gray-500 font-mono">VS</span>
            <span>${m.away}</span>
          </div>
          <div class="grid grid-cols-2 gap-2 text-xs bg-gray-900/50 p-2.5 rounded-xl border border-gray-800/60">
            <div>xG Dom : <span class="font-bold text-white">${m.xgHome}</span></div>
            <div>xG Ext : <span class="font-bold text-white">${m.xgAway}</span></div>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center text-xs">
          <div class="bg-gray-800/50 p-2 rounded-xl border border-gray-700/50">
            <span class="block text-gray-400 text-[10px]">1 (Win)</span>
            <span class="font-bold text-white">${(probs.home * 100).toFixed(1)}%</span>
            <span class="block text-[10px] text-emerald-400">Cote ${oddH.toFixed(2)}</span>
          </div>
          <div class="bg-gray-800/50 p-2 rounded-xl border border-gray-700/50">
            <span class="block text-gray-400 text-[10px]">N (Nul)</span>
            <span class="font-bold text-white">${(probs.draw * 100).toFixed(1)}%</span>
            <span class="block text-[10px] text-emerald-400">Cote ${oddD.toFixed(2)}</span>
          </div>
          <div class="bg-gray-800/50 p-2 rounded-xl border border-gray-700/50">
            <span class="block text-gray-400 text-[10px]">2 (Away)</span>
            <span class="font-bold text-white">${(probs.away * 100).toFixed(1)}%</span>
            <span class="block text-[10px] text-emerald-400">Cote ${oddA.toFixed(2)}</span>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

function renderStats() {
  $("#stat-total").textContent = MATCHES.length;
  $("#stat-value").textContent = MATCHES.filter(m => {
    const p = calculatePoissonMatrix(m.xgHome, m.xgAway);
    return (p.home * (1/p.home)) > 1.05;
  }).length;
}

function renderVip() {
  const tiers = [
    { name: "Pass 1 Jour", price: "1 000 FCFA", desc: "Idéal pour les matchs du week-end" },
    { name: "Pass Semaine", price: "3 000 FCFA", desc: "Accès complet 7 jours" },
    { name: "Pass Mois VIP", price: "5 000 FCFA", desc: "Le plus populaire & rentable" }
  ];
  $("#vip-tiers").innerHTML = tiers.map(t => `
    <div class="bg-gray-900/60 p-4 rounded-2xl border border-amber-500/20 flex flex-col justify-between space-y-2">
      <div><h4 class="font-display font-bold text-white text-sm">${t.name}</h4><p class="text-xs text-gray-400 mt-1">${t.desc}</p></div>
      <div class="flex items-center justify-between pt-2 border-t border-gray-800"><span class="font-display font-bold text-amber-400 text-sm">${t.price}</span><span class="text-[10px] text-emerald-400 font-semibold">Orange / Coris Money</span></div>
    </div>
  `).join('');

  CONFIG = { vip: { whatsapp: "22674823324", price: "5000 FCFA" } };
  $("#wa-btn").href = "https://wa.me/" + CONFIG.vip.whatsapp + "?text=" + encodeURIComponent("Bonjour, je souhaite activer l'abonnement VIP STX ScoreMaster au numéro +226 74 82 33 24.");
}

async function loadLive() {
    try {
        const response = await fetch("https://v3.football.api-sports.io/fixtures?live=all", {
            headers: {
                "x-apisports-key": "071d7c751749949a7ba5bfac5cf27d06"
            }
        });
        const data = await response.json();
        
        if (data.response && data.response.length > 0) {
            MATCHES = data.response.map(f => ({
                home: f.teams.home.name,
                away: f.teams.away.name,
                league: f.league.name,
                time: f.fixture.status.short,
                xgHome: 1.5,
                xgAway: 1.2
            }));
            $("#source").textContent = "Matchs réels · Connecté à API-Football";
        } else {
            MATCHES = [
                { home: "Manchester City", away: "Arsenal", league: "Premier League", time: "19:00", xgHome: 2.1, xgAway: 1.6 },
                { home: "Real Madrid", away: "FC Barcelona", league: "La Liga", time: "21:00", xgHome: 1.9, xgAway: 1.8 },
                { home: "Inter Milan", away: "Juventus", league: "Serie A", time: "20:45", xgHome: 1.4, xgAway: 1.3 }
            ];
            $("#source").textContent = "Mode simulation actif (Aucun match en direct actuellement).";
        }
    } catch (e) {
        console.warn("API indisponible :", e);
        MATCHES = [
            { home: "Manchester City", away: "Arsenal", league: "Premier League", time: "19:00", xgHome: 2.1, xgAway: 1.6 },
            { home: "Real Madrid", away: "FC Barcelona", league: "La Liga", time: "21:00", xgHome: 1.9, xgAway: 1.8 }
        ];
        $("#source").textContent = "Mode démonstration actif.";
    }
}

$("#tabs").addEventListener("click", e => {
    const b = e.target.closest("button");
    if (b) { currentLeague = b.dataset.l; renderTabs(); renderMatches(); }
});

renderStats(); renderVip();
$("#matches").innerHTML = '<p class="col-span-full text-center text-gray-400 py-12">Chargement des matchs en direct...</p>';

loadLive().finally(() => {
    renderTabs();
    renderMatches();
    renderStats();
});
</script>
